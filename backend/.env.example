MUSE_API_KEY=...

PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=
# Set one server-only key. Never expose it in frontend code.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres fallback for chart queries.
SUPABASE_DIRECT_CONNECTION_KEY=

# Optional: Practice video uploads use this public Supabase Storage bucket.
SUPABASE_CHART_BUCKET=chart-videos
MAX_VIDEO_UPLOAD_MB=500