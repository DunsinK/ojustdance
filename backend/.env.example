PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your_service_or_secret_key
SUPABASE_DIRECT_CONNECTION_KEY=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional
# Use an existing charts table without running schema changes on startup.
SKIP_DB_INIT=1
SUPABASE_CHART_BUCKET=chart-videos
MAX_VIDEO_UPLOAD_MB=500
